# Deine Domain (DNS-A-Eintrag muss auf die IP des Hetzner-Servers zeigen)
DOMAIN=example.com

# Geheimes Token für den Heimserver-Agent. Erzeugen mit:  openssl rand -hex 32
# GENAU DENSELBEN Wert trägt dein Kumpel beim Agent ein.
AGENT_TOKEN=

# Erstes Admin-Konto (wird nur angelegt, solange es noch keine Benutzer gibt)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Maximale Größe des Video-Caches auf dem Server in GB
CACHE_MAX_GB=20

# Hinter Caddy immer true lassen
TRUST_PROXY=true

# --- Twitch (optional) ---
# Das Relay holt jeden Twitch-Kanal genau einmal und verteilt denselben Stream an alle im Raum.
# Ohne Token schaut das Relay anonym (mit Twitch-Werbung). Mit dem Token eines Kontos mit
# Turbo bzw. Abo des Kanals ist es werbefrei. Token: im Browser auf twitch.tv angemeldet
# F12 → Konsole → document.cookie.match(/auth-token=(\w+)/)[1]
TWITCH_OAUTH=
# Wie viele Minuten das Relay zum Zurückspulen/Pausieren vorhält
TWITCH_DVR_MINUTES=15
# Abstand zur Live-Kante in Sekunden (Puffer, damit alle gleichzeitig laden können)
TWITCH_DELAY_SECONDS=4

# --- Titelvorschläge für das Schwarze Brett (optional, TMDb) ---
# Beim Wünsche-Eintippen erscheinen Vorschläge mit Poster und Jahr; der Wunsch
# bekommt damit eine stabile TMDB-ID (saubere Duplikat-Erkennung).
# Kostenloser Zugang: themoviedb.org registrieren → Einstellungen → API
# (v3-Schlüssel oder v4-Lesezugang, beides wird akzeptiert). Ohne Eintrag bleibt
# das Brett wie bisher ohne Vorschläge.
tmdb_api_key=
