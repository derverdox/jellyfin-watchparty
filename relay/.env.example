# Deine Domain (DNS-A-Eintrag muss auf die IP des Hetzner-Servers zeigen)
DOMAIN=example.com

# Geheimes Token für den Heimserver-Agent. Erzeugen mit:  openssl rand -hex 32
# GENAU DENSELBEN Wert trägt dein Kumpel beim Agent ein.
AGENT_TOKEN=

# Erstes Admin-Konto (wird nur angelegt, solange es noch keine Benutzer gibt)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Maximale Größe des Video-Caches auf dem Server in GB
CACHE_MAX_GB=20

# Hinter Caddy immer true lassen
TRUST_PROXY=true

# --- Optional: Produktquellen für den ISBN/EAN-Scan (/scan) ---
# Ohne diese Angaben funktionieren nur bereits bestätigte Barcodes und die
# manuelle Suche. Alle Quellen sind freiwillig und werden der Reihe nach gefragt.
# ean-search.org "Product API" (günstig, gute deutsche Medien-Abdeckung):
SCAN_EANSEARCH=
# Google Books API-Schlüssel (optional; reine ISBN-Datenbank, gratis):
SCAN_GOOGLE_BOOKS=
# Discogs-Zugang (optional, erhöht nur das Rate-Limit):
SCAN_DISCOGS=
# Open Library ist immer aktiv (ISBN-Datenbank, gratis, ohne Schlüssel).
