# Adresse des Relays (wss:// = verschlüsselt)
RELAY_URL=wss://example.com/agent

# Exakt derselbe Wert wie AGENT_TOKEN auf dem Hetzner-Server
AGENT_TOKEN=

# Wie dieser Rechner Jellyfin erreicht
JELLYFIN_URL=http://localhost:8096
# Jellyfin → Dashboard → API-Schlüssel → "+"
JELLYFIN_API_KEY=
# Optional: als welcher Jellyfin-Benutzer die Bibliothek gezeigt wird (leer = erster Admin)
JELLYFIN_USER=

# ---- Admin-UI für Bibliotheks-Ausschlüsse (nur im LAN erreichbar, nie übers Internet) ----
# Port der Admin-UI (Standard 8098). Setze ADMIN_TOKEN, um sie im LAN zu öffnen:
# http://<IP-dieses-Rechners>:8098  → nach Token fragen → Bibliotheken ein-/ausschalten.
ADMIN_PORT=8098
ADMIN_TOKEN=

# Maximale Upload-Bandbreite vom Agent zum Relay in Mbit/s (Komma als Dezimaltrennzeichen erlaubt).
# 0 oder weglassen = ungedrosselt. Nützlich, damit der Upload des Heimanschlusses
# frei bleibt (z. B. für TrueNAS-Syncs, Backups oder andere Mitbewohner):
MAX_UPLOAD_MBPS=15
